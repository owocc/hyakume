# AI 配置 (支持 cloudflare | deepseek | openai | custom)
AI_PROVIDER="deepseek"
AI_BASE_URL="https://api.deepseek.com/v1"
AI_API_KEY="sk-your-api-key"
AI_MODEL="deepseek-chat"

# Cloudflare 凭据 (可选，用于部署上线或绑定云端资源)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# PostgreSQL 数据库连接 (Drizzle ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appstore"

# Better Auth 配置 (生成一个 32+ 位的密钥)
BETTER_AUTH_SECRET="your-32-plus-characters-random-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# ----------------------------------------------------
# OAuth 社交登录配置 (可选，填入后将启用对应快捷登录)
# ----------------------------------------------------
# GitHub OAuth App:
#   创建地址: https://github.com/settings/developers
#   Authorization callback URL 请填写:
#   http://localhost:3000/api/auth/callback/github (本地开发)
#   或 https://your-domain.com/api/auth/callback/github (线上环境)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth 2.0 客户端:
#   创建地址: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URIs 请填写:
#   http://localhost:3000/api/auth/callback/google (本地开发)
#   或 https://your-domain.com/api/auth/callback/google (线上环境)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
