# AI 配置 (支持 cloudflare | deepseek | openai | custom)
AI_PROVIDER="deepseek"
AI_BASE_URL="https://api.deepseek.com/v1"
AI_API_KEY="sk-your-api-key"
AI_MODEL="deepseek-chat"

# Cloudflare 凭据 (可选，用于部署上线或绑定云端资源)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# PostgreSQL 数据库连接 (Drizzle ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appstore"

# Better Auth 配置 (生成一个 32+ 位的密钥)
BETTER_AUTH_SECRET="your-32-plus-characters-random-secret-here"
BETTER_AUTH_URL="http://localhost:3000"
